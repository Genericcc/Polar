/*
 * Editor-side styling for the Kanban window.
 *
 * Deliberately separate from Assets/UI/Styles/Tokens.uss: that file dresses the runtime HUD panel and
 * hardcodes a dark palette, whereas this window has to stay legible in both editor skins. Colours here
 * come from Unity's own editor USS variables; only spacing, radius and sizing are local tokens, named
 * to match Tokens.uss so the two files read as a set.
 */

:root {
    --kanban-space-1: 4px;
    --kanban-space-2: 8px;
    --kanban-space-3: 12px;

    --kanban-radius-sm: 3px;
    --kanban-radius-md: 6px;

    /* Fallbacks only. KanbanFontScale always puts a .kanban-scale--N class on the window root, and the
       blocks below redefine every one of these. They are duplicated here so a window that somehow has
       no scale class still lays out rather than collapsing to zero-size controls. */
    --kanban-font: 14px;
    --kanban-font-sm: 12px;
    --kanban-column-width: 300px;
    --kanban-glyph-width: 29px;
    --kanban-control-size: 22px;
    --kanban-row-height: 20px;
    --kanban-label-width: 86px;
}

/*
 * Text size setting. Each block is one entry in KanbanFontScale.Sizes; the class is swapped on the
 * window root when the setting changes.
 *
 * Text size alone is not enough: chips, icon buttons, the glyph slot and the inline select buttons all
 * have fixed pixel sizes, and growing only the font would clip their own text. Column width grows too,
 * because larger text in a fixed-width lane just wraps sooner.
 *
 * These come after :root deliberately - same specificity, so source order decides the winner.
 */
.kanban-scale--11 {
    --kanban-font: 11px;
    --kanban-font-sm: 9px;
    --kanban-column-width: 250px;
    --kanban-glyph-width: 24px;
    --kanban-control-size: 18px;
    --kanban-row-height: 16px;
    --kanban-label-width: 70px;
}

.kanban-scale--12 {
    --kanban-font: 12px;
    --kanban-font-sm: 10px;
    --kanban-column-width: 265px;
    --kanban-glyph-width: 26px;
    --kanban-control-size: 20px;
    --kanban-row-height: 17px;
    --kanban-label-width: 76px;
}

.kanban-scale--13 {
    --kanban-font: 13px;
    --kanban-font-sm: 11px;
    --kanban-column-width: 280px;
    --kanban-glyph-width: 27px;
    --kanban-control-size: 21px;
    --kanban-row-height: 18px;
    --kanban-label-width: 80px;
}

.kanban-scale--14 {
    --kanban-font: 14px;
    --kanban-font-sm: 12px;
    --kanban-column-width: 300px;
    --kanban-glyph-width: 29px;
    --kanban-control-size: 22px;
    --kanban-row-height: 20px;
    --kanban-label-width: 86px;
}

.kanban-scale--16 {
    --kanban-font: 16px;
    --kanban-font-sm: 13px;
    --kanban-column-width: 330px;
    --kanban-glyph-width: 32px;
    --kanban-control-size: 25px;
    --kanban-row-height: 22px;
    --kanban-label-width: 96px;
}

.kanban-scale--18 {
    --kanban-font: 18px;
    --kanban-font-sm: 15px;
    --kanban-column-width: 360px;
    --kanban-glyph-width: 35px;
    --kanban-control-size: 28px;
    --kanban-row-height: 25px;
    --kanban-label-width: 106px;
}

.kanban-scale--20 {
    --kanban-font: 20px;
    --kanban-font-sm: 16px;
    --kanban-column-width: 390px;
    --kanban-glyph-width: 38px;
    --kanban-control-size: 31px;
    --kanban-row-height: 27px;
    --kanban-label-width: 116px;
}

/* Inherited by everything in the window, the drag ghost included (it is parented to the root, outside
   .kanban-root). Controls whose own font size Unity's editor stylesheet sets are handled explicitly
   further down - inheritance alone does not beat a rule that names the element. */
:root {
    font-size: var(--kanban-font);
}

/* Text fields and buttons get it named explicitly rather than by inheritance: Unity's editor theme
   styles these by class, and a class rule beats an inherited value no matter how far up it was set.
   Single-class selectors on purpose, so the small-tier rules further down (.chip, .field-row__label,
   .field-def__kind, ...) still win for the elements that are meant to stay small. */
.unity-base-text-field__input {
    font-size: var(--kanban-font);
}

.kanban-toolbar .unity-toolbar-button {
    font-size: var(--kanban-font);
}

.conflict-bar__button {
    font-size: var(--kanban-font);
}

/* ---------------------------------------------------------------- window */

.kanban-root {
    flex-grow: 1;
    background-color: var(--unity-colors-window-background);
}

/* Unity's own Toolbar style sets a fixed ~21px height, which clips its buttons' text at the larger
   sizes. min-height clamps height in Yoga, so this wins without having to fight the built-in rule. */
.kanban-toolbar {
    flex-direction: row;
    align-items: center;
    min-height: var(--kanban-control-size);
}

.kanban-toolbar .unity-toolbar-button {
    min-height: var(--kanban-control-size);
}

.kanban-toolbar__title {
    width: 200px;
    margin-left: var(--kanban-space-1);
}

.kanban-toolbar__title .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-font-style: bold;
}

.kanban-toolbar__spacer {
    flex-grow: 1;
}

.kanban-toolbar__dirty {
    color: var(--unity-colors-default-text);
    opacity: 0.5;
    font-size: var(--kanban-font-sm);
    margin-left: var(--kanban-space-2);
}

.kanban-toolbar__dirty--hidden {
    display: none;
}

/* ------------------------------------------------------- conflict banner */

.conflict-bar {
    display: none;
    flex-direction: row;
    align-items: center;
    padding: var(--kanban-space-1) var(--kanban-space-2);
    background-color: var(--unity-colors-helpbox-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.conflict-bar--visible {
    display: flex;
}

.conflict-bar__label {
    flex-grow: 1;
    color: var(--unity-colors-default-text);
    white-space: normal;
}

.conflict-bar__button {
    margin-left: var(--kanban-space-1);
}

/* ---------------------------------------------------------------- board */

.kanban-body {
    flex-grow: 1;
}

/* Stretch the scroller's content box to full height so columns run the height of the window
   instead of shrink-wrapping their cards. */
.kanban-body #unity-content-viewport {
    flex-grow: 1;
}

.kanban-body #unity-content-container {
    flex-grow: 1;
    min-height: 100%;
}

.kanban-columns {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    padding: var(--kanban-space-2);
}

/* --------------------------------------------------------------- column */

.column {
    width: var(--kanban-column-width);
    flex-shrink: 0;
    margin-right: var(--kanban-space-2);
    border-radius: var(--kanban-radius-md);
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-helpbox-background);
    overflow: hidden;
}

.column__accent {
    height: 3px;
    flex-shrink: 0;
    /* Actual colour is applied inline from KanbanColumn.ColorHex. */
    background-color: rgb(120, 120, 120);
}

.column__header {
    flex-direction: row;
    align-items: center;
    padding: var(--kanban-space-1);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.column__title {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    min-width: 40px;
}

.column__title .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--kanban-radius-sm);
    -unity-font-style: bold;
}

.column__count {
    color: var(--unity-colors-default-text);
    opacity: 0.55;
    font-size: var(--kanban-font-sm);
    margin-right: var(--kanban-space-1);
    flex-shrink: 0;
}

.column__color {
    width: 24px;
    flex-shrink: 0;
    margin: 0 var(--kanban-space-1) 0 0;
}

.column__scroll {
    flex-grow: 1;
}

.column__tasks {
    padding: var(--kanban-space-1);
    min-height: 60px;
}

/* Highlights the column the pointer is currently hovering during a drag. */
.column--drop-target {
    background-color: var(--unity-colors-highlight-background);
}

/* ----------------------------------------------------------------- card */

.card {
    margin-bottom: var(--kanban-space-1);
    padding: var(--kanban-space-1);
    border-radius: var(--kanban-radius-sm);
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-window-background);
}

.card:hover {
    border-color: var(--unity-colors-highlight-background);
}

/* The element that follows the pointer. Absolutely positioned on the window root so it can
   travel across column boundaries without being clipped by a column's ScrollView. */
.card--ghost {
    position: absolute;
    opacity: 0.85;
    width: 240px;
    flex-direction: row;
    align-items: center;
    background-color: var(--unity-colors-window-background);
    border-color: var(--unity-colors-highlight-background);
}

/* flex-start, not center: once a title wraps to two or three lines, a vertically centred arrow and
   "..." button drift away from the line they act on. The grip still stretches to the full row height,
   which makes it a larger drag target on a tall card rather than a smaller one. */
.card__row {
    flex-direction: row;
    align-items: flex-start;
}

/* Dedicated grab area - and it has to be a real target, not a hairline. The rest of the card row is
   text fields and buttons, which keep their own click behaviour, and the title field takes all the
   remaining width, so this strip is very nearly the only draggable pixel column on the card. It
   stretches to the row's full height for the same reason. */
.card__grip {
    width: 10px;
    align-self: stretch;
    min-height: var(--kanban-row-height);
    flex-shrink: 0;
    margin-right: var(--kanban-space-1);
    border-radius: 2px;
    background-color: var(--unity-colors-default-border);
    opacity: 0.7;
    cursor: pan;
}

.card__grip:hover {
    opacity: 1;
    background-color: var(--unity-colors-default-text);
}

.card__toggle {
    width: var(--kanban-control-size);
    height: var(--kanban-control-size);
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: var(--kanban-font-sm);
}

/* Titles wrap rather than truncate - a card whose title is cut off is useless at a glance, and there
   is no tooltip or detail window to recover the rest of it from. The card grows to fit instead.
   Also applies to the drag ghost's title, which is a Label carrying the same class. */
.card__title {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    min-width: 40px;
    white-space: normal;
}

.card__title .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--kanban-radius-sm);
    white-space: normal;
}

.card__desc-holder {
    display: none;
    padding-left: var(--kanban-control-size);
    padding-top: var(--kanban-space-1);
}

.card__desc-holder--expanded {
    display: flex;
}

.card__desc {
    margin: 0;
}

.card__desc .unity-base-text-field__input {
    min-height: 48px;
    white-space: normal;
}

/* Insertion marker shown at the index a dragged card would land on. */
.card-placeholder {
    margin-bottom: var(--kanban-space-1);
    border-radius: var(--kanban-radius-sm);
    border-width: 1px;
    border-color: var(--unity-colors-default-text);
    opacity: 0.4;
    background-color: var(--unity-colors-highlight-background);
}

/* While a descriptor drives the order, the grip is dimmed to signal that reordering *within* a column
   is off - but it stays fully pickable, because dragging a card to a DIFFERENT column still re-homes
   the task and has to keep working. An earlier version hid it with visibility:hidden, which also makes
   an element unpickable and so took cross-column dragging away with it. */
.column--sorted .card__grip {
    opacity: 0.35;
}

.column--sorted .card__grip:hover {
    opacity: 0.9;
}

/* --------------------------------------------------- descriptors on cards */

.card__chips {
    flex-direction: row;
    flex-wrap: wrap;
    padding-left: var(--kanban-control-size);
    padding-top: var(--kanban-space-1);
}

/* A card with no descriptor values must not pay for the row at all - collapsed rather than
   zero-height, so it contributes no padding either. */
.card__chips--empty {
    display: none;
}

.chip {
    flex-direction: row;
    align-items: center;
    min-height: var(--kanban-row-height);
    margin: 0 var(--kanban-space-1) 0 0;
    padding: 0 6px;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: 8px;
    background-color: var(--unity-colors-helpbox-background);
    font-size: var(--kanban-font-sm);
}

.chip:hover {
    border-color: var(--unity-colors-default-text);
}

/* Outlines the descriptor the board is currently ordered by, so "why is this card here" is answerable
   without looking back up at the toolbar. */
.chip--sort-key {
    border-color: var(--unity-colors-default-text);
    border-width: 1px;
}

.chip__dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    margin-right: var(--kanban-space-1);
    border-radius: 3px;
    background-color: rgb(120, 120, 120);
}

.chip__label {
    color: var(--unity-colors-default-text);
    font-size: var(--kanban-font-sm);
}

.card__fields {
    margin-top: var(--kanban-space-1);
    padding-top: var(--kanban-space-1);
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
}

.card__fields--empty {
    display: none;
}

.field-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.field-row__label {
    width: var(--kanban-label-width);
    flex-shrink: 0;
    color: var(--unity-colors-default-text);
    opacity: 0.65;
    font-size: var(--kanban-font-sm);
}

.field-row__input {
    flex-grow: 1;
    margin: 0;
}

.field-row__select {
    flex-grow: 1;
    min-height: var(--kanban-row-height);
    margin: 0;
    padding: 0 var(--kanban-space-1);
    border-radius: var(--kanban-radius-sm);
    font-size: var(--kanban-font);
    -unity-text-align: middle-left;
}

/* -------------------------------------------------- descriptor editor window */

.fields-window {
    padding: var(--kanban-space-2);
    background-color: var(--unity-colors-window-background);
}

.field-def {
    margin-bottom: var(--kanban-space-2);
    padding: var(--kanban-space-1);
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: var(--kanban-radius-md);
    background-color: var(--unity-colors-helpbox-background);
}

.field-def__header {
    flex-direction: row;
    align-items: center;
}

.field-def__name {
    flex-grow: 1;
    margin: 0;
}

.field-def__name .unity-base-text-field__input {
    -unity-font-style: bold;
}

.field-def__kind {
    min-width: var(--kanban-label-width);
    flex-shrink: 0;
    min-height: var(--kanban-row-height);
    margin: 0 var(--kanban-space-1);
    font-size: var(--kanban-font-sm);
}

/* Indented under the header so it reads as belonging to that descriptor rather than as a sibling. */
.field-def__options {
    margin-top: var(--kanban-space-1);
    padding-left: var(--kanban-space-3);
}

.field-def__add-option {
    align-self: flex-start;
    min-height: var(--kanban-row-height);
    margin: var(--kanban-space-1) 0 0 0;
    font-size: var(--kanban-font-sm);
}

.option-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.option-row__color {
    width: 28px;
    flex-shrink: 0;
    margin: 0 var(--kanban-space-1) 0 0;
}

.option-row__value {
    flex-grow: 1;
    margin: 0;
}

.fields-window__add {
    align-self: flex-start;
    min-height: var(--kanban-row-height);
    margin: 0;
    font-size: var(--kanban-font);
}

.fields-window__hint {
    margin-top: var(--kanban-space-2);
    color: var(--unity-colors-default-text);
    opacity: 0.55;
    font-size: var(--kanban-font-sm);
    white-space: normal;
}

/* --------------------------------------------------------------- shared */

.glyph-field {
    width: var(--kanban-glyph-width);
    flex-shrink: 0;
    margin: 0 var(--kanban-space-1) 0 0;
}

.glyph-field .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-center;
    padding: 0;
}

.icon-button {
    width: var(--kanban-control-size);
    height: var(--kanban-control-size);
    flex-shrink: 0;
    margin: 0 0 0 var(--kanban-space-1);
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: var(--kanban-font-sm);
    -unity-font-style: bold;
}

.icon-button:hover {
    background-color: var(--unity-colors-highlight-background);
    border-radius: var(--kanban-radius-sm);
}
