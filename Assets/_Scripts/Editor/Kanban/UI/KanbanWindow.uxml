<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="kanban-root" class="kanban-root">
        <uie:Toolbar name="kanban-toolbar" class="kanban-toolbar">
            <ui:TextField name="board-title" class="kanban-toolbar__title" tooltip="Board title" />
            <ui:Label name="dirty-indicator" text="unsaved" class="kanban-toolbar__dirty" />
            <ui:VisualElement class="kanban-toolbar__spacer" />
            <uie:ToolbarButton name="add-column" text="+ Column" tooltip="Append a new column" />
            <uie:ToolbarButton name="reload" text="Reload" tooltip="Discard in-memory state and re-read board.json" />
            <uie:ToolbarButton name="reveal" text="Show File" tooltip="Reveal board.json in the file browser" />
        </uie:Toolbar>

        <ui:VisualElement name="conflict-bar" class="conflict-bar">
            <ui:Label name="conflict-label" text="board.json changed on disk." class="conflict-bar__label" />
            <ui:Button name="conflict-reload" text="Reload From Disk" class="conflict-bar__button" />
            <ui:Button name="conflict-keep" text="Keep Mine" class="conflict-bar__button" />
        </ui:VisualElement>

        <!-- Horizontal scrolling is set in KanbanWindow.CreateGUI so the compiler checks it. -->
        <ui:ScrollView name="columns-scroll" class="kanban-body">
            <ui:VisualElement name="columns" class="kanban-columns" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
