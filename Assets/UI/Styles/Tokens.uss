:root {
    --color-bg: rgba(18, 20, 26, 0.92);
    --color-surface: rgba(30, 33, 42, 0.94);
    --color-surface-alt: rgba(44, 48, 60, 0.94);
    --color-border: rgba(255, 255, 255, 0.1);
    --color-text: rgb(235, 237, 242);
    --color-text-dim: rgb(158, 164, 178);
    --color-accent: rgb(96, 172, 255);
    --color-danger: rgb(233, 98, 98);

    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;

    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 14px;

    --font-size-sm: 12px;
    --font-size-md: 14px;
    --font-size-lg: 18px;
}
