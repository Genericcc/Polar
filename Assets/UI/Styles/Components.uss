.chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(30, 33, 42, 0.94);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 8px 12px;
    margin-right: 8px;
}

.chip__label {
    color: rgb(158, 164, 178);
    font-size: 12px;
    margin-right: 8px;
}

.chip__value {
    color: rgb(235, 237, 242);
    font-size: 14px;
    -unity-font-style: bold;
}

.placement-status {
    background-color: rgba(30, 33, 42, 0.94);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 12px 16px;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    opacity: 1;
}

.placement-status__label {
    color: rgb(235, 237, 242);
    font-size: 14px;
    margin-right: 16px;
}

.placement-status__cancel {
    background-color: rgb(233, 98, 98);
    color: rgb(235, 237, 242);
    border-width: 0;
    border-radius: 4px;
    padding: 4px 12px;
}

.structure-info {
    background-color: rgba(30, 33, 42, 0.94);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 16px;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    opacity: 1;
}

.structure-info__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.structure-info__icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
}

.structure-info__name {
    color: rgb(235, 237, 242);
    font-size: 18px;
    -unity-font-style: bold;
}

.structure-info__row {
    color: rgb(158, 164, 178);
    font-size: 12px;
    margin-bottom: 4px;
}

.structure-info__cost {
    margin-top: 8px;
}

.cost-row {
    flex-direction: row;
    justify-content: space-between;
}

.cost-row__label {
    color: rgb(158, 164, 178);
    font-size: 12px;
}

.cost-row__value {
    color: rgb(235, 237, 242);
    font-size: 12px;
}

.build-bar__items {
    background-color: rgba(18, 20, 26, 0.92);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 8px;
}

.structure-button {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    flex-shrink: 0;
    margin: 0 8px 0 0;
    background-color: rgba(30, 33, 42, 0.94);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.structure-button:hover {
    background-color: rgba(44, 48, 60, 0.94);
}

.structure-button:disabled {
    opacity: 0.4;
}

.structure-button__icon {
    width: 36px;
    height: 36px;
    margin-bottom: 4px;
}

.structure-button__label {
    color: rgb(235, 237, 242);
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.is-hidden {
    opacity: 0;
    translate: 0 12px;
}
