.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
}

.top-bar {
    position: absolute;
    left: 16px;
    top: 16px;
    right: 16px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.resource-bar {
    flex-direction: row;
}

.placement-status {
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
}

.structure-info {
    position: absolute;
    right: 16px;
    bottom: 148px;
    width: 260px;
}

.build-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    align-items: center;
}

.build-bar__items {
    flex-direction: row;
}
